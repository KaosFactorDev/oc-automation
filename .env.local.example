# Plantilla del entorno LOCAL de desarrollo (sin producción).
#
# Copiar a .env.local (ignorado por git) y llenar en UTF-8 sin BOM.
# Los valores escritos son los locales y no son secretos. Solo hay que llenar
# las tres marcadas como SECRETO LOCAL; las de «Siempre vacías en local» se
# dejan vacías.
# NO se construye copiando .env.example: este perfil deja vacías, a propósito,
# todas las credenciales externas.
#
# Se arranca con --env-file, no con un .env:
#   node --env-file=.env.local src/scripts/db-migrar.js       (= npm run db:push)
#   node --env-file=.env.local src/scripts/db-clave-app.js    (= npm run db:clave)
#   node --env-file=.env.local src/servidor-cotizaciones.js   (= npm start)
#   docker compose -f docker-compose.dev.yml --env-file .env.local up -d
#
# dotenv no sobrescribe una variable ya definida, así que las que aquí quedan
# vacías siguen vacías aunque exista un .env con credenciales reales.
#
# Node: 22 o superior en Windows (better-sqlite3 no publica binario para
# Node 20 en win32-x64).

# ── Modo prueba y puerto ─────────────────────────────────────────────────────
# Corta subidas al Drive, correos y solicitudes a tesorería. Siempre 1 en local.
MODO_PRUEBA=1
# 3002 y no 3001: el 3001 es de pdf-service en el entorno de KAOS.
PUERTO_COTIZACIONES=3002
TZ=America/Bogota
# La consola web no se usa en local (el login es de Microsoft y no hay
# credenciales). Es el valor que el código calcula con el puerto 3002.
AUTH_REDIRECT_URI=http://localhost:3002/auth/callback

# ── Postgres local (docker-compose.dev.yml, 127.0.0.1:55432) ─────────────────
# Dueño de la base (lo usa el contenedor al crearla).
POSTGRES_DB=erp
POSTGRES_USER=postgres
# SECRETO LOCAL: solo letras y dígitos.
POSTGRES_PASSWORD=
# Rol de administración (db:push, db:clave). 127.0.0.1 y no localhost: en
# Windows localhost puede resolver a ::1 y el contenedor solo escucha en IPv4.
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=postgres
# Rol de la aplicación (lo crea la migración de permisos, sin contraseña).
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=55432
ERP_DB_NAME=erp
ERP_DB_USER=erp_app
# SECRETO LOCAL: solo letras y dígitos, distinta de POSTGRES_PASSWORD. La
# asigna db:clave.
ERP_DB_PASSWORD=
# DATABASE_URL, MIGRATION_DB_URL y PG_CA_CERT NO se definen: DATABASE_URL y
# MIGRATION_DB_URL tienen prioridad sobre las variables de arriba.

# ── API para RRHH (/api/*) ───────────────────────────────────────────────────
# SECRETO LOCAL: llave de prueba, igual a ERP_API_KEY de supabase/functions/.env
# de kaos-webapp, para que crear-orden-erp local llegue a este ERP.
RRHH_API_KEY=

# ── Siempre vacías en local ──────────────────────────────────────────────────
# Microsoft Graph (buzón, Drive y login): sin ellas, getToken() falla antes de
# llamar a Microsoft.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
MAILBOX=
POLLING_INTERVAL_MIN=
# Vacío: no se crea un admin inicial en la consola.
USUARIO_EMAIL=
# Tesorería (Cash_Flow de producción).
TESORERIA_URL=
TESORERIA_ANON_KEY=
TESORERIA_EMAIL=
TESORERIA_PASSWORD=
# Clonado desde el VPS (db:clonar está prohibido en local).
VPS_SSH=
VPS_SSH_KEY=
# Gemini.
GEMINI_API_KEY=
# kaos-api (kaos:sync y afines).
KAOS_API_URL=
KAOS_API_KEY=
