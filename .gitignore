# Dependencias
node_modules/

# Variables de entorno con secretos
# .env y CUALQUIER variante: respaldos, .env.local, .env.produccion.
# El patrón ".env" a secas solo cubre el nombre exacto, así que un
# ".env.respaldo-20260903" quedaba fuera y se podía commitear con los
# secretos dentro.
.env
.env.*
!.env.example

# Base de datos SQLite (runtime)
data/local.db
data/local.db-shm
data/local.db-wal

# Archivos temporales y logs
logs/
temp/
*.log

# Respaldos de Postgres (los genera deploy/respaldo-db.sh en el VPS)
respaldos/

# Carpeta interna de Claude Code
.claude/

# Archivos archivados
_archivo/
