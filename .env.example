# ── Rutas a las bases de datos ────────────────────────────────────────────────
# Ajustar según la ubicación real de los archivos en el servidor

PATH_COMPRAS=./data/compras.csv
PATH_PROVEEDORES=./data/proveedores_depurados_final.csv
PATH_PROYECTOS=./data/tabla_proyectos.csv

# ── Microsoft Graph API (para leer correos de Outlook) ────────────────────────
# Obtener estos valores del portal Azure AD (App Registration)
TENANT_ID=7eecb0b2-8a95-4a99-8a71-86257bf74b06
CLIENT_ID=4af79357-1df7-412b-90c1-eb8ad25507ae
CLIENT_SECRET=da28a385-aea8-4777-98b4-a59c9d3919fd

# ── SharePoint (sitio con las listas: Requerimientos, OrdenesCompra, etc.) ────
SHAREPOINT_HOSTNAME=civiltechic562.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Gestion-de-Proyectos

# ── Buzón a monitorear ────────────────────────────────────────────────────────
MAILBOX=abastecimiento@civiltechic.com

# ── Identificación del usuario (para auditoría y bootstrap del admin inicial) ─
# El nombre y cargo del firmante ya no salen de acá: el nombre se toma del
# login de Microsoft y el cargo se edita en el panel de usuarios (/usuarios).
USUARIO_EMAIL=correo@civiltechic.com

# ── Carpeta de salida para OCs generadas ─────────────────────────────────────
# Puede ser ruta local, OneDrive o SharePoint
OUTPUT_DIR=./output/ordenes_compra

# ── Intervalo de polling en minutos (si no se usa webhook) ────────────────────
POLLING_INTERVAL_MIN=5

# ── SQLite local (caché de lecturas) ──────────────────────────────────────────
SQLITE_PATH=./data/local.db          # ruta al archivo de base de datos local
SYNC_INTERVAL_MIN=2                   # frecuencia de sync SharePoint → SQLite (minutos)

# ── Autenticación ERP (Microsoft OAuth) ──────────────────────────────────────
# Debe coincidir exactamente con la redirect_uri registrada en Azure AD (plataforma "Web").
# Para acceso local: http://localhost:3001/auth/callback
# Para Cloudflare Tunnel: https://erp.civiltechic.com/auth/callback
#
# Si copiaste el .env del VPS, esta variable trae la URL de producción y hay
# que cambiarla a localhost para trabajar en local: con la URL de producción
# el login te saca del localhost, y además la cookie de sesión se marca Secure
# y el navegador la descarta sobre http://. Cada entorno tiene su propio .env
# (este archivo no se despliega), así que basta con dejar el valor correcto
# y comentar el otro.
AUTH_REDIRECT_URI=http://localhost:3001/auth/callback

# ── IA (extracción de PDFs/cotizaciones y matching semántico) ────────────────
# Obtener en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<api-key>
# Modelo de Gemini (opcional). Por defecto gemini-3.5-flash.
#
# NO usar aliases móviles aquí (gemini-flash-latest, gemini-pro-latest). Parecen
# la opción cómoda —Google los reapunta solo al flash GA vigente— pero eso es
# justo el problema: el 2026-08-25 Google movió gemini-flash-latest a
# gemini-3.7-flash y la extracción de cotizaciones se cayó en producción sin que
# cambiáramos una línea. Un alias móvil significa que un cambio del lado de Google
# llega a producción sin pasar por un deploy.
#
# OJO CON LA CUOTA — esto no lo arregla ningún modelo. En free tier el límite es de
# 20 requests por día, POR MODELO y por proyecto. Cambiar de modelo no sube el
# techo: solo estrena un cupo nuevo, porque la cuota se cuenta por modelo. Con 20
# al día repartidos entre /extraer, /os/extraer y la lectura de requerimientos del
# mailer, un equipo lo agota en una mañana.
#
# Para saber en qué tier estás, provoca un 429 y mira el error: la métrica se llama
# generate_content_free_tier_requests y el quotaId termina en -FreeTier. El consumo
# actual se ve en https://ai.dev/rate-limit. La única salida es vincular una cuenta
# de facturación al proyecto de Google Cloud; no hay tier intermedio.
#
# Fija siempre una versión concreta y verifica que responda antes de ponerla:
#   curl -s -o /dev/null -w '%{http_code} %{time_total}s\n' -X POST \
#     "https://generativelanguage.googleapis.com/v1beta/models/$GEMINI_MODEL:generateContent?key=$GEMINI_API_KEY" \
#     -H 'Content-Type: application/json' \
#     -d '{"contents":[{"parts":[{"text":"Responde solo: OK"}]}]}'
GEMINI_MODEL=gemini-3.5-flash

# ── Numeración de OC / OS ──────────────────────────────────────────────────────
OC_PREFIX=OC-
OC_PAD=4
OS_PREFIX=OS-
OS_PAD=4
# Consecutivo inicial si el historial en SQLite/SharePoint está vacío (opcional)
# CONTADOR_OC_INICIAL=1
# CONTADOR_OS_INICIAL=1

# ── Adjuntos de correo (descarga temporal, se puede dejar por defecto) ────────
# DIR_ADJUNTOS=./temp/adjuntos

# ── Tesorería / Pagos Diarios (Cash_Flow) ────────────────────────────────────
# Permite enviar una solicitud de pago desde una OC aprobada. Si falta
# cualquiera de las cuatro variables, la integración simplemente NO aparece en
# la consola (ni columna "Tesorería" ni botón) — no rompe nada.
#
# Requiere un usuario dedicado de Supabase con rol 'solicitante'. Ver la sección
# "Integración con tesorería" en INSTALACION.md.
#
# El JWT y la contraseña nunca salen del servidor: el navegador solo habla con
# las rutas /tesoreria/* del ERP.
TESORERIA_URL=https://<project-ref>.supabase.co
TESORERIA_ANON_KEY=<anon / publishable key>
TESORERIA_EMAIL=oc-automation@thekaosfaktor.com
TESORERIA_PASSWORD=<contraseña>

# ── Zona horaria ────────────────────────────────────────────────────────────
# Debe fijarse explícitamente en Docker/Linux para que el horario laboral del
# procesamiento automático de correos (cron) se evalúe en hora de Colombia.
TZ=America/Bogota
